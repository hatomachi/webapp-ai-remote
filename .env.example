# ==============================================================================
# AI Remote Bridge Agent 環境設定例 (.env)
# ==============================================================================

# 社内AWS EC2 上の Relay Hub WebSocket URL
# - Nginxサブパス(/ai/)経由の場合: ws://<EC2-HOST>/ai/ws/agent (または wss://...)
# - ポート直指定の場合: ws://<EC2-HOST>:3001/ws/agent
HUB_URL=ws://<EC2のIPまたはドメイン>/ai/ws/agent

# Hub との共通認証トークン (EC2側の AUTH_TOKEN と一致させてください)
AUTH_TOKEN=dev-secret-token

# [Windows 11 の場合] Claude Code コマンド (通常は claude.cmd で自動認識されます)
# 必要に応じてフルパス指定: C:\Users\<ユーザー名>\AppData\Roaming\npm\claude.cmd
# CLAUDE_BIN=claude.cmd

# 社内PCで探索・操作するプロジェクトの親ディレクトリ
# 指定すると、PWA上でこのフォルダ配下のGitリポジトリをワンタップで切り替え可能になります
# 例 (Windows): C:\work または C:\Users\<ユーザー名>\work
# PROJECTS_ROOT=C:\work
